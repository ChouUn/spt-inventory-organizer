<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ChouUn.StashMaster</AssemblyName>
    <RootNamespace>ChouUn.StashMaster</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- SPT 安装目录来自环境变量或 -p:SPT_DIR=...，本机路径不进仓库 -->
  <Target Name="RequireSptDir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SPT_DIR)' == ''"
           Text="SPT_DIR 未设置：请指向 SPT 4.1 安装目录" />
  </Target>

  <PropertyGroup>
    <BepInExCoreDir>$(SPT_DIR)\BepInEx\core\</BepInExCoreDir>
    <SptPluginsDir>$(SPT_DIR)\BepInEx\plugins\spt\</SptPluginsDir>
    <TarkovManagedDir>$(SPT_DIR)\EscapeFromTarkov_Data\Managed\</TarkovManagedDir>
  </PropertyGroup>

  <!-- 游戏与框架自带的程序集只作编译引用，不复制到输出 -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" Private="false"
               HintPath="$(TarkovManagedDir)Newtonsoft.Json.dll" />
    <Reference Include="BepInEx" Private="false"
               HintPath="$(BepInExCoreDir)BepInEx.dll" />
    <Reference Include="0Harmony" Private="false"
               HintPath="$(BepInExCoreDir)0Harmony.dll" />
    <Reference Include="spt-reflection" Private="false"
               HintPath="$(SptPluginsDir)spt-reflection.dll" />
    <Reference Include="Assembly-CSharp" Private="false"
               HintPath="$(TarkovManagedDir)Assembly-CSharp.dll" />
    <Reference Include="Comfort" Private="false"
               HintPath="$(TarkovManagedDir)Comfort.dll" />
    <Reference Include="ItemComponent.Types" Private="false"
               HintPath="$(TarkovManagedDir)ItemComponent.Types.dll" />
    <Reference Include="Sirenix.Serialization" Private="false"
               HintPath="$(TarkovManagedDir)Sirenix.Serialization.dll" />
    <Reference Include="Unity.TextMeshPro" Private="false"
               HintPath="$(TarkovManagedDir)Unity.TextMeshPro.dll" />
    <Reference Include="UnityEngine" Private="false"
               HintPath="$(TarkovManagedDir)UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" Private="false"
               HintPath="$(TarkovManagedDir)UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.UI" Private="false"
               HintPath="$(TarkovManagedDir)UnityEngine.UI.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>
