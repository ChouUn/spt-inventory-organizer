<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ChouUn.StashMaster.Plugin.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <BepInExCoreDir>$(SPT_DIR)\BepInEx\core\</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Plugin/Configuration/ItemTypeNames.cs"
             Link="ItemTypeNames.cs" />
    <Compile Include="../../src/Plugin/Configuration/ItemTypeOrderFile.cs"
             Link="ItemTypeOrderFile.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- 链接实际兼容实现，使用游戏安装的 Harmony，不加载 Unity 或游戏程序集。 -->
    <Compile Include="../../src/Plugin/Compatibility/UIFixesCompatibility.cs"
             Link="UIFixesCompatibility.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio"
                      Version="2.8.2" PrivateAssets="all" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)0Harmony.dll" />
    <Reference Include="MonoMod.RuntimeDetour"
               HintPath="$(BepInExCoreDir)MonoMod.RuntimeDetour.dll" />
    <Reference Include="MonoMod.Utils"
               HintPath="$(BepInExCoreDir)MonoMod.Utils.dll" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExCoreDir)Mono.Cecil.dll" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Compile Include="../../src/Plugin/Adapter/ItemTypeClassifier.cs"
             Link="ItemTypeClassifier.cs" />
    <Reference Include="netstandard"
      HintPath="$(SPT_DIR)\EscapeFromTarkov_Data\Managed\netstandard.dll" />
    <Compile Include="../../src/Plugin/Diagnostics/SortSimulation.cs"
             Link="SortSimulation.cs" />
    <Compile Include="../../src/Plugin/Diagnostics/NativeGridSearch.cs"
             Link="NativeGridSearch.cs" />
    <ProjectReference Include="../../src/Core/Core.csproj" />
    <Reference Include="Assembly-CSharp"
      HintPath="$(SPT_DIR)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll" />
    <Reference Include="Comfort"
      HintPath="$(SPT_DIR)\EscapeFromTarkov_Data\Managed\Comfort.dll" />
    <Reference Include="UnityEngine.CoreModule"
      HintPath="$(SPT_DIR)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll" />
  </ItemGroup>

</Project>
